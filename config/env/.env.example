# =============================================================================
# PlanBlue — Root Environment Reference
# Copy per-app examples into apps/web/.env.local and apps/cms/.env
# Never commit real secrets.
# =============================================================================

# --- PostgreSQL (local dev) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=planblue
DATABASE_USERNAME=planblue
DATABASE_PASSWORD=planblue_dev
DATABASE_SSL=false

# --- Strapi (apps/cms) ---
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# --- Cloudflare R2 (Strapi upload provider — configure later) ---
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Resend (email — configure later) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com

# --- Next.js (apps/web) ---
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000
