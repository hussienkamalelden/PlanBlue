# Strapi — copy to apps/cms/.env

HOST=0.0.0.0
PORT=1337

# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=planblue
DATABASE_USERNAME=planblue
DATABASE_PASSWORD=planblue_dev
DATABASE_SSL=false

# Cloudflare R2 (S3-compatible) — wire up in config/plugins.ts later
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Resend — wire up in Strapi email plugin / custom service later
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com
