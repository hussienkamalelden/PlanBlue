{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order_id": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "total": {
      "type": "decimal",
      "required": true
    },
    "status_type": {
      "type": "enumeration",
      "enum": [
        "processing",
        "pending",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "address": {
      "type": "text",
      "required": true
    },
    "extra_notes": {
      "type": "text"
    },
    "promo_code": {
      "type": "string"
    },
    "governorate": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Cairo",
        "Giza",
        "Alexandria",
        "Qalyubia",
        "Sharqia",
        "Dakahlia",
        "Monufia",
        "Gharbia",
        "Kafr El Sheikh",
        "Beheira",
        "Damietta",
        "Port Said",
        "Ismailia",
        "Suez",
        "North Sinai",
        "South Sinai",
        "Matrouh",
        "New Valley",
        "Faiyum",
        "Beni Suef",
        "Minya",
        "Asyut",
        "Sohag",
        "Qena",
        "Luxor",
        "Aswan",
        "Red Sea"
      ]
    },
    "order_items": {
      "type": "json",
      "required": true
    }
  }
}
