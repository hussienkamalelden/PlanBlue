{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order_id": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "total": {
      "type": "decimal",
      "required": true
    },
    "status_type": {
      "type": "enumeration",
      "enum": [
        "processing",
        "pending",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "address": {
      "type": "text",
      "required": true
    },
    "order_items": {
      "type": "text",
      "required": true
    },
    "extra_notes": {
      "type": "text"
    }
  }
}
