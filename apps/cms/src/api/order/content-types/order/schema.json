{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order_id": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "total": {
      "type": "decimal",
      "required": true
    },
    "status_type": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "address": {
      "type": "text",
      "required": true
    },
    "extra_notes": {
      "type": "text"
    },
    "promo_code": {
      "type": "string"
    },
    "governorate": {
      "type": "string",
      "required": true
    },
    "shipping_cost": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "follow_up_call": {
      "type": "text"
    },
    "order_items": {
      "type": "component",
      "component": "orders.order-item",
      "repeatable": true
    },
    "is_processed": {
      "type": "boolean",
      "default": false
    },
    "is_stock_reversed": {
      "type": "boolean",
      "default": false
    }
  }
}
